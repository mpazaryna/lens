# Provider: anthropic, openai, or ollama
LENS_PROVIDER=anthropic
LENS_MODEL=claude-sonnet-4-20250514

# API key (not needed for ollama)
LENS_API_KEY=sk-ant-your-key-here

# Optional: custom API endpoint (e.g., Azure OpenAI, Ollama on remote host)
# LENS_BASE_URL=http://localhost:11434

# Data directory
LENS_DATA_DIR=data
LENS_LOG_LEVEL=info

# Legacy (still works as fallback for LENS_API_KEY)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
